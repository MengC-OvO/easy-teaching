APP_NAME=eduflow-au-agent
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_PATH=data/local/eduflow.sqlite3
CHECKPOINT_DATABASE_PATH=data/local/checkpoints.sqlite3
POSTGRES_DB=eduflow
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_URL=postgresql+psycopg://eduflow:replace-with-a-long-random-local-password@127.0.0.1:5432/eduflow
CHECKPOINT_DATABASE_URL=postgresql://eduflow:replace-with-a-long-random-local-password@127.0.0.1:5432/eduflow
MODEL_BASE_URL=https://your-model-provider.example/v1
MODEL_CHAT_COMPLETIONS_PATH=/chat/completions
MODEL_API_KEY=replace-with-your-local-key
MODEL_NAME=gemini-2.5-flash
MODEL_TIMEOUT_SECONDS=10
MODEL_RETRY_MAX_ATTEMPTS=3
MODEL_RETRY_INITIAL_DELAY_SECONDS=0.5
MODEL_RETRY_MAX_DELAY_SECONDS=2
MODEL_TOTAL_TIMEOUT_SECONDS=30
MODEL_STRUCTURED_MAX_ATTEMPTS=2
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_API_KEY=replace-with-your-local-key
EMBEDDING_MODEL_NAME=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_SECONDS=20
CHROMA_PATH=data/chroma
CHROMA_COLLECTION_NAME=eduflow_knowledge
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
AUTH_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
AUTH_TIMEOUT_SECONDS=5
AUTH_COOKIE_MAX_AGE_SECONDS=3600
