APP_NAME=easy-teaching
APP_ENV=local
LOG_LEVEL=INFO
PRIVACY_GATEWAY_MODE=disabled
PRIVACY_GATEWAY_URL=http://127.0.0.1:8010
PRIVACY_GATEWAY_TIMEOUT_SECONDS=15
SAFETY_MODEL_DIR=local_models/Qwen2.5-3B-Instruct
SAFETY_ADAPTER_DIR=local_models/easyteaching-safety-lora
SAFETY_MAX_INPUT_TOKENS=1536
SAFETY_MAX_NEW_TOKENS=320
SAFETY_MAPPING_TTL_SECONDS=3600
POSTGRES_DB=easyteaching
POSTGRES_USER=easyteaching
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
REDIS_PASSWORD=replace-with-a-different-long-random-password
DATABASE_URL=postgresql+psycopg://easyteaching:replace-with-a-long-random-local-password@127.0.0.1:5432/easyteaching
CHECKPOINT_DATABASE_URL=postgresql://easyteaching:replace-with-a-long-random-local-password@127.0.0.1:5432/easyteaching
TASK_EXECUTION_MODE=celery
REDIS_URL=redis://:replace-with-a-different-long-random-password@127.0.0.1:6379/0
REDIS_PROGRESS_URL=redis://:replace-with-a-different-long-random-password@127.0.0.1:6379/1
REDIS_PROGRESS_STREAM_MAXLEN=500
REDIS_PROGRESS_TTL_SECONDS=3600
REDIS_PROGRESS_BLOCK_MS=15000
CELERY_BROKER_URL=redis://:replace-with-a-different-long-random-password@127.0.0.1:6379/0
CELERY_QUEUE_NAME=easyteaching.agent
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=840
CELERY_TASK_TIME_LIMIT_SECONDS=900
CELERY_TASK_MAX_RETRIES=3
CELERY_WORKER_PREFETCH_MULTIPLIER=1
OUTBOX_POLL_INTERVAL_SECONDS=2
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=20
API_RATE_LIMIT_WINDOW_SECONDS=60
MODEL_BASE_URL=https://your-model-provider.example/v1
MODEL_CHAT_COMPLETIONS_PATH=/chat/completions
MODEL_API_KEY=replace-with-your-local-key
MODEL_NAME=gemini-2.5-flash
MODEL_TIMEOUT_SECONDS=10
MODEL_RETRY_MAX_ATTEMPTS=3
MODEL_RETRY_INITIAL_DELAY_SECONDS=0.5
MODEL_RETRY_MAX_DELAY_SECONDS=2
MODEL_STRUCTURED_MAX_ATTEMPTS=3
MODEL_TOTAL_TIMEOUT_SECONDS=30
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_API_KEY=replace-with-your-local-key
EMBEDDING_MODEL_NAME=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_SECONDS=20
CHROMA_PATH=data/chroma
CHROMA_COLLECTION_NAME=easyteaching_knowledge
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
AUTH_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
AUTH_TIMEOUT_SECONDS=5
AUTH_COOKIE_MAX_AGE_SECONDS=3600
GOOGLE_DRIVE_MCP_ENABLED=false
GOOGLE_DRIVE_MCP_COMMAND=workspace-mcp
GOOGLE_DRIVE_USER_EMAIL=teacher@example.com
GOOGLE_DRIVE_MCP_TIMEOUT_SECONDS=45
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
WORKSPACE_MCP_CREDENTIALS_DIR=data/local/google_workspace_mcp
UPLOAD_ROOT=data/local/uploads
UPLOAD_MAX_BYTES=15728640
SCOPED_KNOWLEDGE_ROOT=data/local/knowledge/tenants
SCOPED_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SCOPED_EMBEDDING_DIMENSION=384
OFFICIAL_WEB_SEARCH_ENABLED=false
OFFICIAL_WEB_SEARCH_API_KEY=replace-with-google-programmable-search-key
OFFICIAL_WEB_SEARCH_ENGINE_ID=replace-with-search-engine-id
OFFICIAL_WEB_SEARCH_TIMEOUT_SECONDS=12
VOICE_TRANSCRIPTION_ENABLED=false
WHISPER_MODEL_NAME=small.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8_float16
